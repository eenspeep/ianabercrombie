rules_version = '2';

// DNGN webcomic data. Public read (so anyone can view the comic); writes are
// restricted to the site owner's authenticated account only.
//
// The owner UID below is the account allowed to write. Publish these rules in
// the Firebase console (Firestore Database → Rules) or via
// `firebase deploy --only firestore:rules`.

service cloud.firestore {
  match /databases/{database}/documents {

    // One document per comic page: pages/{pageNumber}
    match /pages/{page} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == 'URBZG88uPMNkaHhZoRRtIqvo9hl2';
    }

    // Site metadata (e.g. meta/site.latestPage/dates, meta/characters).
    match /meta/{doc} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == 'URBZG88uPMNkaHhZoRRtIqvo9hl2';
    }

    // Unpublished drafts — private to the owner (read AND write).
    match /drafts/{id} {
      allow read, write: if request.auth != null
                         && request.auth.uid == 'URBZG88uPMNkaHhZoRRtIqvo9hl2';
    }

    // Reader command submissions — anyone may create (validated); only the
    // owner may read, mark handled, or delete.
    match /submissions/{id} {
      allow read, update, delete: if request.auth != null
                                  && request.auth.uid == 'URBZG88uPMNkaHhZoRRtIqvo9hl2';
      allow create: if request.resource.data.command is string
                    && request.resource.data.command.size() > 0
                    && request.resource.data.command.size() < 500
                    && request.resource.data.page is int;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
